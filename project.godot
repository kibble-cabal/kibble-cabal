; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KibbleCabal2D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

ItemDB="*res://apps/item/classes/item_db.gd"
LuaSystem="*res://apps/mod/classes/lua_system.gd"
SaveSystem="*res://apps/save/classes/save_system.gd"
LocationSystem="*res://apps/location/classes/location_system.gd"
PlayerSystem="*res://apps/player/classes/player_system.gd"

[display]

window/size/viewport_width=1125
window/size/viewport_height=2436
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale=3.0
window/handheld/orientation=1

[dotnet]

project/assembly_name="KibbleCabal2D"

