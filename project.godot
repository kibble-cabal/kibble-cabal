[limbo_ai]

behavior_tree/behavior_tree_default_dir="res://"
behavior_tree/user_task_dir_1="res://apps/ai/classes/tasks"
behavior_tree/user_task_dir_2="res://expansion_packs/core-pet/ai/classes/tasks"

[physics]

3d/physics_engine="JoltPhysics3D"

[rendering]

camera/depth_of_field/depth_of_field_bokeh_shape=0
environment/ssao/quality=1
environment/ssao/half_size=false
global_illumination/sdfgi/frames_to_converge=2
environment/volumetric_fog/volume_size=32
environment/volumetric_fog/use_filter=0
environment/defaults/default_clear_color=Color(0.208088, 0.208088, 0.208088, 1)
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_environment="res://content/environments/default_environment.tres"
