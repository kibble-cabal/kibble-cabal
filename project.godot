[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[layer_names]

2d_physics/layer_1="world_boundaries"
2d_navigation/layer_1="world_boundaries"
3d_physics/layer_1="world_boundaries"
3d_navigation/layer_1="world_boundaries"
2d_physics/layer_2="players"
2d_navigation/layer_2="player"
3d_physics/layer_2="players"
3d_navigation/layer_2="players"
2d_physics/layer_3="pets"
2d_navigation/layer_3="pets"
3d_physics/layer_3="pets"
