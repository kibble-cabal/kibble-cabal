2d_navigation/layer_1="world_boundaries"
2d_physics/layer_2="players"
2d_navigation/layer_2="player"
2d_physics/layer_3="pets"
2d_navigation/layer_3="pets"
2d_physics/layer_4="items"
2d_physics/layer_5="buildings"

[limbo_ai]

behavior_tree/behavior_tree_default_dir="res://content/ai/trees"
behavior_tree/user_task_dir_1="res://apps/ai/classes/tasks"

[rendering]

