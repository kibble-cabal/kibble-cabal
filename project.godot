; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ability_system]

tags_dock/custom_dir="res://"
attribute_table_dock/custom_dir="res://"

[application]

config/name="KibbleCabal2D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"

[autoload]

Meta="*res://apps/meta/classes/meta.gd"
ExpansionPackDB="*res://apps/expansion_pack/classes/expansion_pack_db.gd"
GameModeDB="*res://apps/game_mode/classes/game_mode_db.gd"
ModDB="*res://apps/mod/classes/mod_db.gd"
LocationDB="*res://apps/location/classes/location_db.gd"
AnimalDB="*res://apps/animal/classes/animal_db.gd"
ItemDB="*res://apps/item/classes/item_db.gd"
SoundEffectDB="*res://apps/sound_effect/classes/sound_effect_db.gd"
MusicDB="*res://apps/music/classes/music_db.gd"
SettingDefinitionDB="*res://apps/settings/classes/setting_definition_db.gd"
QuestDB="*res://apps/quest/classes/quest_db.gd"
SubtreeDB="*res://apps/ai/classes/subtree_db.gd"
AbilityDB="*res://apps/ability/classes/ability_db.gd"
AttributeDB="*res://apps/ability/classes/attribute_db.gd"
EffectDB="*res://apps/ability/classes/effect_db.gd"
TagDB="*res://apps/ability/classes/tag_db.gd"
ActionDB="*res://apps/action/classes/action_db.gd"
ExpansionPackSystem="*res://apps/expansion_pack/classes/expansion_pack_system.gd"
ModSystem="*res://apps/mod/classes/mod_system.gd"
SaveSystem="*res://apps/save/classes/save_system.gd"
GameModeSystem="*res://apps/game_mode/classes/game_mode_system.gd"
LocationSystem="*res://apps/location/classes/location_system.gd"
PetSystem="*res://apps/pet/classes/pet_system.gd"
DatetimeSystem="*res://apps/datetime/classes/datetime_system.gd"
MusicSystem="*res://apps/music/classes/music_system.gd"
LuaSystem="*res://apps/mod/classes/lua_system.gd"
SoundManager="*res://addons/sound_manager/sound_manager.gd"
Sx="*res://addons/signal_extensions/sx_autoload.gd"
UIAnimManager="*res://addons/ui_anim/autoload/ui_anim_manager.gd"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"

[display]

window/size/viewport_width=2880
window/size/viewport_height=1620
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="KibbleCabal2D"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/json_library/json_library/plugin.cfg", "res://addons/rect_pack_2d/plugin.cfg", "res://addons/signal_extensions/plugin.cfg", "res://addons/sound_manager/plugin.cfg", "res://addons/ui_anim/plugin.cfg")

[gui]

common/snap_controls_to_pixels=false
theme/custom="res://content/themes/default_theme.tres"
theme/custom_font="res://content/fonts/montagu_slab/MontaguSlab144pt-Medium.otf"

