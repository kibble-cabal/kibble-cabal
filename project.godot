; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ability_system]

tags_dock/custom_dir="res://"
attribute_table_dock/custom_dir="res://"
csharp/generation_directory="res://addons/ability_system_extension/gen"

[application]

config/name="KibbleCabal2D"
config/tags=PackedStringArray("game")
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2", "C#")
config/icon="res://icon.svg"

[autoload]

SoundManager="*res://addons/sound_manager/sound_manager.gd"
Sx="*res://addons/signal_extensions/sx_autoload.gd"
UIAnimManager="*res://addons/ui_anim/autoload/ui_anim_manager.gd"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"
Meta="*res://apps/meta/classes/Meta.cs"
ImGuiLayer="*res://addons/imgui-godot/ImGuiLayer.tscn"

[debug_draw_3d]

settings/3d/add_bevel_to_volumetric_geometry=false
settings/3d/volumetric_defaults/thickness=0.02
settings/3d/volumetric_defaults/hd_spheres=true

[display]

window/size/viewport_width=2880
window/size/viewport_height=1620
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="KibbleCabal2D"

[editor]

script/templates_search_path="res://templates"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/imgui-godot/plugin.cfg", "res://addons/json_library/json_library/plugin.cfg", "res://addons/rect_pack_2d/plugin.cfg", "res://addons/signal_extensions/plugin.cfg", "res://addons/sound_manager/plugin.cfg", "res://addons/ui_anim/plugin.cfg")

[gui]

common/snap_controls_to_pixels=false
theme/custom="res://content/themes/default_theme.tres"
theme/custom_font="res://content/fonts/montagu_slab/MontaguSlab144pt-Medium.otf"

