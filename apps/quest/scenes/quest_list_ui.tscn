[gd_scene load_steps=2 format=3 uid="uid://ffhd3cvr3tii"]

[sub_resource type="GDScript" id="GDScript_4xgr1"]
script/source = "extends ScrollContainer

const QuestScene := preload(\"res://apps/quest/scenes/quest_ui.tscn\")


func _ready() -> void:
	render()


func render() -> void:
	for quest in QuestDB.registered_quests:
		if quest.is_available(SaveSystem.current_save):
			var scene := QuestScene.instantiate()
			%Container.add_child(scene)
			scene.render(quest)
"

