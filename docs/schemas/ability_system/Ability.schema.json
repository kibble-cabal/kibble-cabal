{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/schemas/ability_system/Ability",
  "title": "Ability",
  "type": "object",
  "properties": {
    "Identifier": {
      "type": "string"
    },
    "TagsBlocking": {
      "type": "array",
      "items": {
        "$ref": "docs/schemas/ability_system/Tag"
      }
    },
    "TagsRequired": {
      "type": "array",
      "items": {
        "$ref": "docs/schemas/ability_system/Tag"
      }
    },
    "Effects": {
      "type": "array",
      "items": {
        "$ref": "docs/schemas/ability_system/Effect"
      }
    },
    "EffectMode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "UIColor": {
      "type": "object",
      "properties": {
        "R": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "G": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "B": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "A": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "R",
        "G",
        "B"
      ],
      "additionalProperties": false
    },
    "ResourceLocalToScene": {
      "type": "boolean"
    },
    "ResourcePath": {
      "type": "string"
    },
    "ResourceName": {
      "type": "string"
    }
  },
  "required": [
    "identifier"
  ],
  "additionalProperties": false
}